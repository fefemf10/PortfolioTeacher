{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp": "Information",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "id.ui": {
        "ClusterId": "idui",
        "Match": {
          "Path": "/id/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "id.Account": {
        "ClusterId": "id",
        "Match": {
          "Path": "/id/account/{**catch-all}",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "id.well-known": {
        "ClusterId": "id",
        "Match": {
          "Path": "/id/.well-known/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "id.api": {
        "ClusterId": "id",
        "Match": {
          "Path": "/id/api/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "id": {
        "ClusterId": "id",
        "Match": {
          "Path": "/id/connect/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "frontend": {
        "ClusterId": "frontend",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Append"
          }
        ]
      }
    }
  }
}
