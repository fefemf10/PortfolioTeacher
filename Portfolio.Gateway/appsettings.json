{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Yarp": "Information",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "frontend": {
        "ClusterId": "frontend",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "id": {
        "ClusterId": "id",
        "Match": {
          "Path": "/id/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Append"
          }
        ]
      },
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          {
            "X-Forwarded": "Append"
          }
        ]
      }
    }
  }
}
